module ElectionMachines
  VERSION: String
  REFUSALS: Array[Symbol]
  CLOCK_POLICIES: Array[Symbol]

  # Integer nanoseconds on one monotonic clock, for instants (now, expires_at,
  # observed) and spans (ttl) alike:
  # Process.clock_gettime(Process::CLOCK_MONOTONIC, :nanosecond). A non-Integer
  # raises TypeError; a negative value, or one past 2**64 seconds, RangeError.
  type nanoseconds = Integer
  # An Integer in 0..65_535; TypeError for a non-Integer, RangeError outside.
  type scope = Integer
  # An Integer in 0..2**64-1, the caller's own number for a candidate.
  type owner = Integer
  type clock_policy = :reject | :clamp
  # Every symbol that means "this call was not honoured and changed nothing",
  # and exactly REFUSALS: no catch-all, and none an election cannot answer.
  # :no_candidates is the core's `Refusal::NoCandidates`. The rest are the
  # core's `Refusal::Lease(reason)`, answered as the lease core's own symbol
  # for `reason`. The lease core's :occupied and :held never arrive (a live
  # leader is the honoured Incumbent), nor do :fenced and :out_of_phase (the
  # lease holder's). Each method below lists exactly the ones it can answer.
  type refusal = :no_candidates | :no_lease | :wrong_owner | :stale_token | :unknown | :expired
               | :clock_regressed | :invalid_ttl | :exhausted
  # What heartbeat and resign can answer for the owner, token and clock.
  # :unknown is a token this election never issued, which includes every token
  # of another scope; :stale_token is one it issued that is no longer in force.
  type held_refusal = :unknown | :clock_regressed | :no_lease | :wrong_owner | :stale_token | :expired
  # The core's `Leadership`: both are honoured, Incumbent changed nothing.
  type leadership = Elected | Incumbent

  # Anything read as a fencing token: this gem's FencingToken, or the
  # `lease_machines` gem's. A bare Integer is not one (TypeError).
  interface _FencingToken
    def raw: () -> Integer
  end

  # Anything read as a lease: this gem's Lease, or the `lease_machines` gem's.
  interface _Lease
    def owner: () -> owner
    def token: () -> _FencingToken
    def expires_at: () -> nanoseconds
  end

  # Anything read as a checkpoint: this gem's, or the `lease_machines` gem's.
  interface _Checkpoint
    def scope: () -> scope
    def issued: () -> Integer
    def lease: () -> _Lease?
    def observed: () -> nanoseconds
  end

  class FencingToken < Data
    # Scope in the top 16 bits above a sequence number counted from 1.
    attr_reader raw: Integer
    # TypeError for a non-Integer; RangeError outside 1..2**64-1 or when the
    # sequence number is zero.
    def self.new: (Integer raw) -> FencingToken
                | (raw: Integer) -> FencingToken
    def self.from_raw: (Integer raw) -> FencingToken
    def scope: () -> scope
    # nil across scopes: such tokens are not comparable.
    def order: (_FencingToken other) -> (-1 | 0 | 1)?
    # False across scopes.
    def newer_than?: (_FencingToken other) -> bool
  end

  class Lease < Data
    attr_reader owner: owner
    attr_reader token: FencingToken
    attr_reader expires_at: nanoseconds
    # Validated like a granted one: TypeError for a non-Integer owner or
    # instant or a token without `raw`, RangeError for an owner outside
    # 0..2**64-1, a token `from_raw` rejects or an instant out of range.
    # `token` is read by its readers and kept as this gem's FencingToken.
    def self.new: (owner owner, _FencingToken token, nanoseconds expires_at) -> Lease
                | (owner: owner, token: _FencingToken, expires_at: nanoseconds) -> Lease
  end

  class Checkpoint < Data
    attr_reader scope: scope
    # Tokens issued so far, resignations included; the next is `issued + 1`.
    attr_reader issued: Integer
    attr_reader lease: Lease?
    attr_reader observed: nanoseconds
    # RangeError when `issued` is past 2**48-1, or `lease` does not carry
    # token number `issued` of `scope`. `lease` is read by its readers and
    # kept as this gem's Lease.
    def self.new: (scope scope, Integer issued, _Lease? lease, nanoseconds observed) -> Checkpoint
                | (scope: scope, issued: Integer, lease: _Lease?, observed: nanoseconds) -> Checkpoint
    def self.from_parts: (scope scope, Integer issued, _Lease? lease, nanoseconds observed) -> Checkpoint
  end

  class Elected < Data
    attr_reader lease: Lease
    # `lease` is read by its readers, validated like Lease.new and kept as
    # this gem's Lease: TypeError without the readers, RangeError otherwise.
    def self.new: (_Lease lease) -> Elected
                | (lease: _Lease) -> Elected
    def incumbent?: () -> false
  end

  class Incumbent < Data
    attr_reader lease: Lease
    # Read, validated and kept like Elected's.
    def self.new: (_Lease lease) -> Incumbent
                | (lease: _Lease) -> Incumbent
    def incumbent?: () -> true
  end

  # The core's `Election`. Honoured answers come first in every return type,
  # then the refusals that method can answer. A refusal changes nothing, the
  # observed clock included. Every mutating call raises FrozenError on a
  # frozen election.
  class Election
    # A fresh token namespace in scope zero.
    def self.new: () -> Election
    # A fresh token namespace whose tokens carry `scope`.
    def self.with_scope: (scope scope) -> Election
    # RangeError when `checkpoint` is of another scope. TypeError unless
    # `clock_policy` is a Symbol, RangeError unless :reject or :clamp.
    def self.restored: (scope scope, _Checkpoint checkpoint, clock_policy clock_policy) -> Election
    # Changes this election and answers it. TypeError for a non-Symbol,
    # RangeError unless :reject or :clamp.
    def with_clock_policy: (clock_policy clock_policy) -> self
    def clock_policy: () -> clock_policy
    def scope: () -> scope
    def issued: () -> Integer
    # The last leadership granted; it may have expired. nil after a resignation.
    def lease: () -> Lease?
    def checkpoint: () -> Checkpoint
    # Elected: the smallest candidate, under a new token. Incumbent: a live
    # leader stays, whoever the candidates were; nothing changed.
    # :no_candidates for an empty Array, checked before the clock.
    def elect: (Array[owner] candidates, nanoseconds now, nanoseconds ttl)
               -> (leadership | :no_candidates | :clock_regressed | :invalid_ttl | :exhausted)
    # The renewed Lease, under the same token. A repeat is honoured and never
    # shortens the lease.
    def heartbeat: (owner owner, _FencingToken token, nanoseconds now, nanoseconds ttl)
                   -> (Lease | held_refusal | :invalid_ttl)
    # The Lease that was given up. A repeat is :no_lease.
    def resign: (owner owner, _FencingToken token, nanoseconds now) -> (Lease | held_refusal)

    private

    type row = [Integer, Integer, Integer]
    type saved = [Integer, Integer, row?, Integer]
    def self.native_with_scope: (Integer) -> Election
    def self.native_restored: (Integer, _Checkpoint, Symbol) -> Election
    def native_with_clock_policy: (Symbol) -> nil
    def native_lease: () -> row?
    def native_checkpoint: () -> saved
    def native_elect: (Array[Integer], Integer, Integer) -> (Elected | Incumbent | refusal)
    def native_heartbeat: (Integer, _FencingToken, Integer, Integer) -> (Lease | refusal)
    def native_resign: (Integer, _FencingToken, Integer) -> (Lease | refusal)
  end

  private

  def self.native_raw: (Integer) -> nil
  def self.native_token_scope: (_FencingToken) -> Integer
  def self.native_token_order: (_FencingToken, _FencingToken) -> (-1 | 0 | 1)?
  def self.native_token_newer: (_FencingToken, _FencingToken) -> bool
  def self.native_lease: (owner, _FencingToken, nanoseconds) -> FencingToken
  def self.native_held: (_Lease) -> Lease
  def self.native_checkpoint: (scope, Integer, _Lease?, nanoseconds) -> Lease?
  def self.lease_of: ([Integer, Integer, Integer]) -> Lease
end
